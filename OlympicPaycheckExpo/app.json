{
  "expo": {
    "name": "Olympic Paycheck",
    "slug": "olympic-paycheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "olympicpaycheck",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.olympicpayroll.paycheck"
    },
    "android": {
      "package": "com.olympicpayroll.paycheck",
      "adaptiveIcon": {
        "backgroundColor": "#F2F3F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-torch.png",
          "imageWidth": 110
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Olympic Paycheck to use Face ID so you can sign in without typing your email and SSN."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Olympic Paycheck to use your camera so you can take a profile photo.",
          "photosPermission": "Allow Olympic Paycheck to access your photos so you can choose a profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1768cab-384e-4909-99f6-0a23a5783ad4"
      }
    }
  }
}
